<?xml version="1.0" encoding="utf-8"?>
<Project name="gmr">
    <Package name="main">
        <Key ID="STR_gmr_main_Eden_BeltTime">
            <English>Belt time multiplier</English>
        </Key>
        <Key ID="STR_gmr_main_Eden_BeltTime_Desc">
            <English>Multiplies how long this unit takes to load or unload a belt. Lower is faster.</English>
        </Key>
        <Key ID="STR_gmr_main_Eden_MagazineTime">
            <English>Magazine time multiplier</English>
        </Key>
        <Key ID="STR_gmr_main_Eden_MagazineTime_Desc">
            <English>Multiplies how long this unit takes to load or unload a magazine. Lower is faster.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_AllowPacking">
            <English>Allow packing rounds</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_AllowPacking_Desc">
            <English>Loose rounds can be put back\ninto packs of 10 to 60.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_AmmoRules">
            <English>Ammo rules</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_AmmoRules_Desc">
            <English>Which caliber a magazine counts as,\nfor magazines of other mods.\n\nmagazine: caliber, magazine: caliber\n\nPart of the class name is enough:\nvn_m16: 556x45, CUP_30Rnd_9x39: 9x39</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_AmmoSystem">
            <English>Ammunition system</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_AmmoSystem_Advanced">
            <English>Advanced</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_AmmoSystem_Desc">
            <English>Simple: only the caliber counts.\n\nAdvanced: the type counts as well,\nfor example tracer or AP.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_AmmoSystem_Simple">
            <English>Simple</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_ArsenalHighlight">
            <English>Highlight fitting ammunition</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_ArsenalHighlight_Desc">
            <English>In ACE Arsenal's ammunition tab,\nwhat fits one of your weapons, and\nuniversal ammunition, stands out in green.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_BeltTimeFactor">
            <English>Belt time factor</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_BeltTimeFactor_Desc">
            <English>Multiplies the time a belt takes\nto load or to unload.\n\n1 is normal, 0.5 twice as fast.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_BeltsEnabled">
            <English>Enable belts</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_BeltsEnabled_Desc">
            <English>Off: machine gun belts cannot be\nrefilled or unloaded, and empty ones\ndisappear as usual.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_Container_Auto">
            <English>Automatic</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_Container_Backpack">
            <English>Backpack</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_Container_Uniform">
            <English>Uniform</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_Container_Vest">
            <English>Vest</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_DisableAceRepack">
            <English>Disable ACE repacking</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_DisableAceRepack_Desc">
            <English>Hides ACE's "Repack Magazines" action:\nrounds move by unloading one magazine\nand refilling another.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_DragToLoad">
            <English>Drag to load</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_DragToLoad_Desc">
            <English>Drag rounds, a pack or a belt onto a\nmagazine in the inventory to load it.\n\nThe inventory closes and the normal\naction takes over.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_EmptiesForAI">
            <English>Keep empty magazines for AI</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_EmptiesForAI_Desc">
            <English>AI units keep their empty magazines\nas well. Off saves their inventory\nfrom filling up.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_EmptyContainer">
            <English>Empty magazines go to</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_EmptyContainer_Desc">
            <English>Which container is tried first for\nan empty magazine. When it is full,\nthe others are tried.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_Enabled">
            <English>Enable the mod</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_Enabled_Desc">
            <English>Off: no menus, no empty magazines\nand no reload guard. The items stay.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_FreeRefill">
            <English>Free refill</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_FreeRefill_Desc">
            <English>Magazines and belts can be refilled\nwithout using any rounds.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GuardNotice">
            <English>Show reload guard repairs</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GuardNotice_Desc">
            <English>Shows a line when the reload guard\nputs a magazine back.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_HoldToLoad">
            <English>Hold to load</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_HoldToLoad_Desc">
            <English>On: hold the action key for as long\nas it takes, letting go stops it.\n\nOff: it starts at once and runs by\nitself, Esc stops it.\n\nThe rounds moved stay moved.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_KeepEmpties">
            <English>Keep empty magazines</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_KeepEmpties_Desc">
            <English>An empty magazine goes back into the\ninventory after a reload, and stays\nwhen it is unloaded.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_LoadAnimation">
            <English>Loading animation</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_LoadAnimation_Desc">
            <English>The hands load the magazine round by\nround while it runs, standing or kneeling.\n\nNeeds the weapon put away.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_MaxMagazines">
            <English>Magazines per type in the menu</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_MaxMagazines_Desc">
            <English>How many magazines of one type\nthe menu lists.\n\n0 lists all of them.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_ReloadGuard">
            <English>Reload guard</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_ReloadGuard_Desc">
            <English>Puts a magazine back that the game lost\nduring a reload.\n\nIt only acts when nothing else changed\nin the inventory, and every repair\nis written to the RPT.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_Sounds">
            <English>Play sounds</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_Sounds_Desc">
            <English>A click per round while loading\nor unloading.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_SpeedloaderFactor">
            <English>Speedloader factor</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_SpeedloaderFactor_Desc">
            <English>Multiplies the loading time while a\nspeedloader is in the inventory.\n\nBelts and unloading are not affected.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_TimePerRound">
            <English>Seconds per round</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_TimePerRound_Desc">
            <English>How long one round takes to load\ninto a magazine or to take out of one.\n\nIn the minigame, how long the round\ntakes to fly across, at least 0.25.</English>
        </Key>
        <Key ID="STR_gmr_main_Topic_Magazines">
            <English>Magazines</English>
        </Key>
        <Key ID="STR_gmr_main_Topic_Menu">
            <English>Menu</English>
        </Key>
        <Key ID="STR_gmr_main_Topic_Rules">
            <English>Rules</English>
        </Key>
        <Key ID="STR_gmr_main_Topic_Timing">
            <English>Timing</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_RoundCounter">
            <English>Round counter</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_RoundCounter_Desc">
            <English>Shows the rounds in the magazine\nwhile loading or unloading it.</English>
        </Key>
        <Key ID="STR_gmr_main_Topic_Arsenal">
            <English>ACE Arsenal</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_PacksMustOpen">
            <English>Open packs first</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_PacksMustOpen_Desc">
            <English>A pack dragged onto a magazine does\nnot load it. It has to be opened\nfirst, the rounds then go in.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_ArsenalBelts">
            <English>Show belts</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_ArsenalBelts_Desc">
            <English>Belts are listed in the ammunition\ntab of ACE Arsenal.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_ArsenalPacks">
            <English>Show packs</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_ArsenalPacks_Desc">
            <English>Packs are listed in the ammunition\ntab of ACE Arsenal.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_ArsenalRounds">
            <English>Show single rounds</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_ArsenalRounds_Desc">
            <English>Single rounds are listed in the\nammunition tab of ACE Arsenal.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_UniversalAmmo">
            <English>Universal ammunition</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_UniversalAmmo_Desc">
            <English>Rounds and belts that fit\nany magazine of any caliber.\n\nOff: they are hidden in the arsenal\nand nothing can be loaded from them.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_LoadDisplay">
            <English>Loading display</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_LoadDisplay_Desc">
            <English>What you see while loading.\n\nPanel: magazine, round count\nand the minigame, if it is on.\n\nClassic ring: the hold ring of the\noriginal GreenMag, without minigame.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_LoadDisplay_Panel">
            <English>Panel</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_LoadDisplay_Classic">
            <English>Classic ring</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_LoadGame">
            <English>Loading minigame</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_LoadGame_Desc">
            <English>A round flies across once per round.\nPress the action key when it is on the\nmagazine and it seats at once. A miss\nholds you up for a moment.\n\nFor magazines, not for belts. Hold to\nload does not apply while this is on.</English>
        </Key>
        <Key ID="STR_gmr_main_Topic_Minigame">
            <English>Minigame</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameRewards">
            <English>Streak rewards</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameRewards_Desc">
            <English>A long run of hits pays out extra\nrounds that go in for free in time,\nnot in ammunition.\n\nAt the jackpot streak the magazine\nin hand fills at once.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameRewardStart">
            <English>First reward at streak</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameRewardStart_Desc">
            <English>The streak of hits that pays out\nthe first extra round, x5 for one.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameRewardStep">
            <English>Next reward every</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameRewardStep_Desc">
            <English>After the first reward, another one\nevery this many hits.\n\n2 with the first at x5:\nx5, x7, x9 and so on.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameRewardMaxRounds">
            <English>Most extra rounds</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameRewardMaxRounds_Desc">
            <English>Each reward gives a random number\nof extra rounds, from 1 up to one\nmore per reward in the streak.\n\nNever more than this at once.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameRewardJackpot">
            <English>Jackpot streak</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameRewardJackpot_Desc">
            <English>At this streak, and every multiple\nof it, the magazine in hand fills\nat once.\n\n0 turns the jackpot off.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameMustHit">
            <English>Without a press</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameMustHit_Desc">
            <English>What happens when the round reaches\nthe end and nobody pressed.\n\nLoads anyway: nobody has to play,\nhitting it only makes it faster.\n\nNothing: no round goes in\nuntil it is hit.</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameMustHit_No">
            <English>The round loads anyway</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_GameMustHit_Yes">
            <English>Nothing, it has to be hit</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_ArsenalUsedCalibers">
            <English>Only ammunition in use</English>
        </Key>
        <Key ID="STR_gmr_main_Setting_ArsenalUsedCalibers_Desc">
            <English>Lists only ammunition that a magazine\nof the loaded mods takes: its caliber,\nits kind like tracer or subsonic,\nand rounds or belts.\n\nUniversal ammunition always stays.</English>
        </Key>
    </Package>
</Project>
